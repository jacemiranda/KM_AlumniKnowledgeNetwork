{
    "mcpServers": {
        "StitchMCP": {
            "command": "npx",
            "args": [
                "dotenv-cli",
                "-e",
                ".env.local",
                "--",
                "npx",
                "-y",
                "mcp-remote",
                "https://stitch.googleapis.com/mcp",
                "--header",
                "X-Goog-Api-Key: ${STITCH_API_KEY}"
            ],
            "env": {
                "STITCH_API_KEY": "${STITCH_API_KEY}",
                "STITCH_PROJECT_ID": "${STITCH_PROJECT_ID}"
            }
        }
    }
}